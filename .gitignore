backend/__pycache__/
backend/*.pyc
backend/jobs.json
backend/jobs.csv
backend/logs/
backend/debug_offer.png
__pycache__/

# build output / deps
frontend/dist/
frontend/node_modules/

# editor/local settings
.vscode/
.claude/settings.local.json
